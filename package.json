{
  "name": "edassistant",
  "version": "0.1.0",
  "private": true,
  "description": "Lesson planning assistant for Victorian primary teachers (Victorian Curriculum F-10 Version 2.0, Foundation to Level 6).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "curriculum:scrape": "tsx scripts/curriculum/scrape.ts",
    "curriculum:discover": "tsx scripts/curriculum/scrape.ts --discover",
    "curriculum:seed": "tsx scripts/curriculum/seed.ts",
    "curriculum:download": "tsx scripts/curriculum/download-f10.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cheerio": "^1.2.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "playwright": "^1.48.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
