# --- AI provider: Tenon (https://mytenon.com), OpenAI-compatible, one key for many models ---
# Server-wide key (optional once teachers save their own key on the Usage page). Starts with sk-tx-.
TENON_API_KEY=
# Default model for teachers who haven't picked one. See https://mytenon.com/pricing for ids.
DEFAULT_MODEL=deepseek-v4.1-flash
# TENON_BASE_URL=https://mytenon.com/v1

# Long random string used to encrypt API keys saved on the Usage page (required to save keys).
# Generate one with: openssl rand -base64 32
SETTINGS_SECRET=

# --- Database (optional: accounts, library, templates, feedback, usage) ---
# PostgreSQL connection string. On Render use the database's *Internal* URL.
# Leave blank to run in local mode (no login, nothing saved).
DATABASE_URL=
# Set to "false" to force-disable SSL (it is used automatically for external hostnames).
# DATABASE_SSL=

# Only the first account can sign up. List more emails here (comma-separated) to allow them.
ALLOWED_EMAILS=
# Super admin accounts (comma-separated emails) who can see all users and their usage at /admin.
# Leave blank to use the default, matthew.he@outlook.com.
ADMIN_EMAILS=

# --- Invitation emails (optional) ---
# Resend (https://resend.com) API key and sender. The sender's domain must be verified in Resend.
# Without these, /admin still creates invitations and shows the link for you to send yourself.
RESEND_API_KEY=
# EMAIL_FROM="Lessonroo <invites@yourdomain.com>"
EMAIL_FROM=
