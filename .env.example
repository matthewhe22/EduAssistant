# --- Claude (required for generating plans) ---
ANTHROPIC_API_KEY=
# Defaults: claude-opus-5-5 at "medium" effort. Effort: low | medium | high | xhigh | max
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Supabase (optional: teacher logins + saved plans) ---
# Leave these blank to run in local mode (no login, plans are not saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, for `npm run curriculum:seed`. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
